rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin allow-list: existence of a doc here means that uid is an admin.
    // Only readable by the admin themselves (for the panel's client-side
    // "am I an admin?" check) - never writable from the client. New admins
    // are added directly via the Firebase Admin SDK / service account, not
    // through the app, so this can never be self-escalated.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /orders/{orderId} {
        // Owner can read their own orders; an admin can read every order
        // (this also covers the admin panel's collectionGroup('orders')
        // query, since each returned doc is checked against this same rule).
        allow read: if request.auth != null &&
          (request.auth.uid == userId ||
            exists(/databases/$(database)/documents/admins/$(request.auth.uid)));

        // Only the owning user can create an order (checkout flow).
        allow create: if request.auth != null && request.auth.uid == userId;

        // Owner may only cancel their own order (status -> 'anulata',
        // matching cont.js's existing cancel button) or flag a return
        // request as submitted (returnRequested -> true, set right after a
        // returnRequests doc is created - see below). An admin may only
        // change the status field (confirmata/livrata/etc, admin panel).
        // Neither can rewrite items/total/shipping after the fact.
        allow update: if request.auth != null && (
          (request.auth.uid == userId &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'canceledAt']) &&
            request.resource.data.status == 'anulata') ||
          (request.auth.uid == userId &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['returnRequested']) &&
            request.resource.data.returnRequested == true) ||
          (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        );

        allow delete: if false;
      }
    }

    // 14-day withdrawal-right requests (retur.html / cont.html's order
    // history "Solicită retur" button) - a real online mechanism per OUG
    // 34/2014 art. 11¹, instead of email/phone only.
    match /returnRequests/{requestId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid ||
          exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
      // Only an admin can change status (e.g. mark it handled); the
      // requester never edits their own request after submitting it.
      allow update: if request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    match /counters/{counterId} {
      // Was publicly readable (allow read: if true) - anyone, no account
      // needed, could read the exact running order count as free sales-
      // volume intel. Login is already required to read it now; can't
      // restrict further without breaking checkout, since cos.html's
      // transaction reads this doc as any logged-in customer to compute
      // the next order number - a real fix would move the increment into
      // a Cloud Function, out of scope while this project has none.
      allow read: if request.auth != null;
      // Only checks the new value is +1 of the old - doesn't verify a
      // matching order was actually created in the same write, so any
      // logged-in user can still burn through order numbers by calling
      // this repeatedly without ever placing an order (griefing, not a
      // data-exposure risk). Same Cloud-Function caveat as above.
      allow update: if request.auth != null &&
        request.resource.data.count == resource.data.count + 1;
    }

    // Product reviews (reviews.js) - had NO rule at all before, meaning
    // every read/write was silently rejected by Firestore's default-deny
    // (the feature never actually worked). Public read (reviews are meant
    // to be seen by anyone), but create is locked down: must be logged in,
    // authorUid must match the real requester (no impersonation), rating
    // bounded 1-5, text non-empty and capped, and only these exact fields
    // - no update/delete, so a review can't be edited/vandalized after
    // posting (matches how this feature was actually designed to work).
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.cod is string &&
        request.resource.data.rating is int &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000 &&
        request.resource.data.keys().hasOnly(['cod', 'rating', 'text', 'authorName', 'authorUid', 'createdAt']);
      allow update, delete: if false;
    }
  }
}
